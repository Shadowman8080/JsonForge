<Application x:Class="JsonForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:JsonForge.Converters"
             RequestedTheme="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Load Uno.UI.Toolkit resources -->
        <ToolkitResources xmlns="using:Uno.Toolkit.UI" />
      </ResourceDictionary.MergedDictionaries>

      <!-- JsonForge color resources (VS Code dark palette) -->
      <SolidColorBrush x:Key="JsonKeyBrush" Color="#9CDCFE" />
      <SolidColorBrush x:Key="JsonStringBrush" Color="#CE9178" />
      <SolidColorBrush x:Key="JsonNumberBrush" Color="#B5CEA8" />
      <SolidColorBrush x:Key="JsonKeywordBrush" Color="#569CD6" />
      <SolidColorBrush x:Key="JsonLiteralBrush" Color="#4EC9B0" />
      <SolidColorBrush x:Key="JsonCommentBrush" Color="#6A9955" />
      <SolidColorBrush x:Key="JsonErrorBrush" Color="#F48771" />
      <SolidColorBrush x:Key="JsonPunctBrush" Color="#D4D4D4" />

      <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526" />
      <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="DividerBrush" Color="#3F3F46" />

      <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

      <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
      </Style>

      <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Background" Value="#3A3A3A" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
      </Style>

      <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style x:Key="PaneTabStyle" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,2,4,2" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
